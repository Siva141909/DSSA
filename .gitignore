.DS_Store

# DSSA implementation - large/generated artifacts, not source
dssa/venv/
dssa/checkpoint/*.pt
dssa/checkpoint/.cache/
dssa/reference_sample/
dssa/data/
__pycache__/
*.pyc

# ISPRS raw downloads and staged imagery - large binary data, not source
dssa/Data/
dssa/data/

# Phase 2C training checkpoints (trainable-parameter-only .pt files) - large
# generated artifacts, not source. Run metrics/manifests/reports (JSON/.md)
# are still tracked.
dssa/artifacts/phase2c/**/*.pt

# Phase 2D generated binaries (checkpoints, feature arrays). Run metrics,
# manifests and reports (JSON/.md) stay tracked.
dssa/artifacts/phase2d/**/*.pt
dssa/artifacts/phase2d/**/*.npz

# Image-bearing review deck (contains ISPRS Potsdam/Vaihingen crops; research use only, not to be distributed)
DSSA_Mid_Phase_Review_Final.pptx

# Phase 2D per-step training telemetry (generated; kept in the private release backup, not in Git)
dssa/artifacts/phase2d/**/telemetry.jsonl
